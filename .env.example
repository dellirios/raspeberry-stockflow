HOST=127.0.0.1
PORT=2508
ALLOWED_STORE_KEYS=SUA_STORE_KEY
LONG_POLL_URL=https://stockflow.pro/start.php?store_key=SUA_STORE_KEY&print_feedback=1&calibration_capable=1

# Obtain a separate device credential in the main system. Never reuse another agent's identity.
ZEBRA_FEEDBACK_LOCAL_ONLY=true
ZEBRA_PRINTER_NAME=Zebra_Technologies_ZTC_ZD220-203dpi_ZPL
ZEBRA_USB_SERIAL=SERIAL_DA_SUA_ZEBRA
PRINT_FEEDBACK_TOKEN=
PRINT_FEEDBACK_EVENTS_URL=https://stockflow.pro/api/print-agent/events

# Approved pilot cadence: roughly 700-1300 ms plus HTTP duration.
EMPTY_POLL_BASE_DELAY_MS=1000
NOOP_PAYLOAD_BASE_DELAY_MS=1000
MAX_IDLE_BACKOFF_MS=1000

# To deliberately use legacy CUPS-acceptance reporting instead:
# ZEBRA_FEEDBACK_LOCAL_ONLY=false
# PRINT_FEEDBACK_TOKEN=
# PRINT_FEEDBACK_EVENTS_URL=
# LONG_POLL_URL=https://stockflow.pro/start.php?store_key=SUA_STORE_KEY
